# Focus V2 environment configuration - copy to .env and edit.
# PLACEHOLDERS ONLY - never put real keys in this file or in data.json.
# The desktop agent runs fully offline with Ollama; every variable below is
# optional.

# ---- Local LLM (primary; recommended) ----
# Install Ollama from https://ollama.com, then:  ollama pull qwen3:4b
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen3:4b
# OLLAMA_TIMEOUT=120

# Force the provider regardless of in-app Settings (ollama | online | none)
# FOCUS_LLM_PROVIDER=ollama

# ---- Optional online adapter (OpenAI-compatible; research-heavy chats) ----
# Key is read from the environment ONLY - it is never stored in data files,
# never logged, and never sent anywhere except your chosen base URL.
# ONLINE_LLM_API_KEY=sk-your-key-here
# ONLINE_LLM_BASE_URL=https://api.openai.com/v1
# ONLINE_LLM_MODEL=gpt-4o-mini

# ---- Locale ----
# IANA timezone name used for dates, deadlines and the study window
# FOCUS_TZ=Asia/Dhaka
